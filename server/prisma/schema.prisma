generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WorkflowStatus {
  PENDING
  RUNNING
  AWAITING_HUMAN_APPROVAL
  MANUAL_REVIEW
  COMPLETED
  FAILED
}

enum AutonomyMode {
  HUMAN_APPROVAL_REQUIRED
  REVIEW_ON_EXCEPTION
}

enum Recommendation {
  APPROVE
  REJECT
  REFER
}

enum AgentRunStatus {
  COMPLETED
  FAILED
}

model OnboardingCaseRecord {
  id           String        @id
  payload      Json
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workflowRuns WorkflowRun[]
}

model WorkflowRun {
  id             String               @id @default(cuid())
  caseId         String
  case           OnboardingCaseRecord @relation(fields: [caseId], references: [id], onDelete: Cascade)
  status         WorkflowStatus
  autonomyMode   AutonomyMode
  recommendation Recommendation?
  explanation    String?              @db.Text
  confidence     Float?
  trace          Json
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  agentResults   AgentResult[]
}

model AgentResult {
  id            String         @id @default(cuid())
  workflowRunId String
  workflowRun   WorkflowRun    @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  agentName     String
  attempt       Int
  status        AgentRunStatus
  findings      Json
  confidence    Float
  output        Json?
  error         Json?
  createdAt     DateTime       @default(now())

  @@index([workflowRunId])
}
